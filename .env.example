# ---------------------------------------------------------------------------
#  Pengaturan Dishify
#  1. Salin file ini menjadi ".env" (start.bat melakukannya otomatis).
#  2. Tempel key Gemini BARU kamu setelah tanda "=" (tanpa tanda kutip, tanpa spasi).
#  File .env TIDAK boleh dibagikan ke siapa pun dan tidak ikut ke GitHub.
# ---------------------------------------------------------------------------

# Key dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai.
GEMINI_MODEL=gemini-2.5-flash

# Batas permintaan resep per pengguna (melindungi kuota Gemini kamu).
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50

# Batas pertanyaan "berapa lama bahan ini tahan?" dari My fridge.
SHELF_LIFE_PER_MINUTE=20
SHELF_LIFE_PER_DAY=200

# Batas pertanyaan "bahan ini diganti apa?" dari tombol swap di resep.
SUBSTITUTE_PER_MINUTE=10
SUBSTITUTE_PER_DAY=100

# Panjang maksimal daftar bahan (jumlah karakter).
MAX_INGREDIENTS_CHARS=300

# Hanya untuk hosting online (di Render sudah diatur lewat render.yaml).
# Biarkan kosong di laptop.
CLIENT_IP_HEADER=

# 127.0.0.1 = hanya bisa dibuka dari laptop ini.
# Ganti menjadi 0.0.0.0 kalau ingin membukanya dari HP di Wi-Fi yang sama.
HOST=127.0.0.1
PORT=5000
